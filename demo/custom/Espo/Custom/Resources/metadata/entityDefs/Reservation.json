{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "unit": {
            "type": "link",
            "required": true
        },
        "contact": {
            "type": "link",
            "required": true
        },
        "lead": {
            "type": "link"
        },
        "reservedOn": {
            "type": "date",
            "required": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "expiresOn": {
            "type": "date"
        },
        "deposit": {
            "type": "currency"
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Converted",
                "Expired",
                "Cancelled"
            ],
            "default": "Active",
            "style": {
                "Active": "warning",
                "Converted": "success",
                "Expired": "default",
                "Cancelled": "danger"
            },
            "displayAsLabel": true,
            "audited": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "unit": {
            "type": "belongsTo",
            "entity": "Unit",
            "foreign": "reservations"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "reservations"
        },
        "lead": {
            "type": "belongsTo",
            "entity": "Lead",
            "foreign": "reservations"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}