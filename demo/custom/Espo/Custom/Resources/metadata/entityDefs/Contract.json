{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "number": {
            "type": "autoincrement",
            "readOnly": true
        },
        "unit": {
            "type": "link",
            "required": true
        },
        "contact": {
            "type": "link",
            "required": true
        },
        "lead": {
            "type": "link"
        },
        "status": {
            "type": "enum",
            "options": [
                "Draft",
                "Active",
                "Completed",
                "Cancelled"
            ],
            "default": "Draft",
            "style": {
                "Draft": "default",
                "Active": "primary",
                "Completed": "success",
                "Cancelled": "danger"
            },
            "displayAsLabel": true,
            "audited": true
        },
        "contractDate": {
            "type": "date"
        },
        "startDate": {
            "type": "date"
        },
        "endDate": {
            "type": "date"
        },
        "totalAmount": {
            "type": "currency",
            "required": true
        },
        "downPayment": {
            "type": "currency"
        },
        "remainingAmount": {
            "type": "currency",
            "readOnly": true
        },
        "files": {
            "type": "attachmentMultiple"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "unit": {
            "type": "belongsTo",
            "entity": "Unit",
            "foreign": "contracts"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "contracts"
        },
        "lead": {
            "type": "belongsTo",
            "entity": "Lead",
            "foreign": "contracts"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}