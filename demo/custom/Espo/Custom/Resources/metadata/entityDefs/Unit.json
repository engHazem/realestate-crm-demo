{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "development": {
            "type": "link"
        },
        "type": {
            "type": "enum",
            "options": [
                "Apartment",
                "Villa",
                "Duplex",
                "Chalet",
                "Office",
                "Shop"
            ],
            "default": "Apartment"
        },
        "status": {
            "type": "enum",
            "options": [
                "Available",
                "Reserved",
                "Contracted",
                "Sold",
                "Not for sale",
                "Owner"
            ],
            "default": "Available",
            "style": {
                "Available": "success",
                "Reserved": "warning",
                "Contracted": "primary",
                "Sold": "danger",
                "Not for sale": "default",
                "Owner": "info"
            },
            "displayAsLabel": true,
            "audited": true
        },
        "floor": {
            "type": "int"
        },
        "column": {
            "type": "int"
        },
        "area": {
            "type": "float",
            "required": true
        },
        "rooms": {
            "type": "int",
            "required": true
        },
        "bathrooms": {
            "type": "int"
        },
        "price": {
            "type": "currency",
            "required": true,
            "audited": true
        },
        "features": {
            "type": "multiEnum",
            "options": [
                "Swimming Pool",
                "Parking",
                "Elevator",
                "Garden",
                "Balcony",
                "Security",
                "Air Conditioning",
                "Furnished",
                "Sea View",
                "Near Beach"
            ]
        },
        "images": {
            "type": "attachmentMultiple"
        },
        "buyer": {
            "type": "link"
        },
        "soldDate": {
            "type": "date"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "development": {
            "type": "belongsTo",
            "entity": "Development",
            "foreign": "units"
        },
        "buyer": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "units"
        },
        "reservations": {
            "type": "hasMany",
            "entity": "Reservation",
            "foreign": "unit"
        },
        "contracts": {
            "type": "hasMany",
            "entity": "Contract",
            "foreign": "unit"
        },
        "interestedLeads": {
            "type": "hasMany",
            "entity": "Lead",
            "foreign": "interestedUnit"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}